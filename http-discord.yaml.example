type: http
name: http_default
log_level: info
group_wait: 10s
group_threshold: 1
max_retry: 3
timeout: 10s

format: |
  {
    "embeds": [
      {{range $idx, $alert := . -}}
      {{if $idx}},{{end}}
      {
        "title": "🚨 CrowdSec Security Alert",
        "color": 15158332,
        "description": "**Source IP:** `{{.Source.IP}}`{{if .Source.Cn}} :flag_{{.Source.Cn | lower}}:{{end}}\n**Attack Type:** `{{.Scenario}}`{{if .Message}}\n*{{.Message}}*{{end}}",
        "fields": [
          {{range $didx, $decision := .Decisions -}}
          {{if $didx}},{{end}}
          {
            "name": "🔒 Action Taken",
            "value": "**{{.Type | upper}}** IP `{{.Value}}` for **{{.Duration}}**",
            "inline": false
          },
          {
            "name": "🔎 Request Info",
            "value": "**Host:** `{{ or (GetMeta $alert "target_fqdn") (GetMeta $alert "target_host") "unknown" }}`\n**Path:** `{{ or (GetMeta $alert "http_path") (GetMeta $alert "target_uri") "unknown" }}`",
            "inline": false
          },
          {
            "name": "🌍 Location & Network",
            "value": "{{if $alert.Source.Cn}}:flag_{{$alert.Source.Cn | lower}}: **{{$alert.Source.Cn}}**{{else}}Unknown{{end}}{{if $alert.Source.AsName}}\n🏢 {{$alert.Source.AsName}}{{end}}{{if $alert.Source.AsNumber}} (AS{{$alert.Source.AsNumber}}){{end}}{{if $alert.Source.Range}}\n📡 Range: `{{$alert.Source.Range}}`{{end}}",
            "inline": false
          },
          {
            "name": "⏰ Timeline",
            "value": "**Started:** {{$alert.StartAt}}\n**Stopped:** {{$alert.StopAt}}",
            "inline": true
          },
          {
            "name": "📊 Detection Info",
            "value": "**Capacity:** {{$alert.Capacity}}\n**Leak Speed:** {{$alert.Leakspeed}}",
            "inline": true
          }
          {{end -}}
        ],
        "footer": {
          "text": "CrowdSec Security • srv904135 • cloud-m3.com"
        },
        "timestamp": "{{.CreatedAt}}"
      }
      {{end -}}
    ]
  }

url: "https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN"
method: POST
headers:
  Content-Type: "application/json"
